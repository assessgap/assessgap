package views

templ Home(s Site) {
	@Layout(s, "AssessGap — Is your Cook County assessment higher than your neighbors'?",
		"A free check that compares your home's assessed value with similar homes nearby, using public Cook County data.") {
		<section id="check" class="relative overflow-visible">
			<div class="absolute inset-x-0 top-0 -z-10 h-[32rem] bg-gradient-to-b from-emerald-50 to-transparent"></div>
			<div class="mx-auto max-w-3xl px-5 pt-8 pb-12 sm:pt-20 sm:pb-16 text-center">
				<p class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-sm text-emerald-800 ring-1 ring-emerald-200">
					<span class="size-1.5 rounded-full bg-emerald-600"></span>
					Free · Cook County homes · No sign-up
				</p>
				<h1 class="mt-5 sm:mt-6 text-3xl sm:text-5xl font-semibold tracking-tight text-slate-900 text-balance">
					Is your home assessed higher than similar homes nearby?
				</h1>
				<p class="mt-4 sm:mt-5 sm:text-lg text-slate-600 text-pretty">
					We compare your building's assessed value per square foot with similar homes in your Assessor neighborhood
					and show you the numbers, so you can decide whether an appeal is worth your time.
				</p>
				<div class="mt-6 sm:mt-10 text-left">
					@SearchBox("", true)
				</div>
				<p class="mt-4 text-left text-sm sm:text-center">
					<a href="/townships" class="inline-flex min-h-11 items-center font-medium text-emerald-800 underline underline-offset-4">Appeal dates for all 38 townships →</a>
				</p>
			</div>
		</section>
		<section class="mx-auto max-w-5xl px-5 pb-16" aria-label="Board of Review facts">
			<div class="grid gap-4 sm:grid-cols-3">
				@stat(s.WinRate(), "of homeowners who appealed on their own at the Board of Review got a reduction", s.Years())
				@stat(s.AppealsShort(), "self-filed residential appeals in the data we analyzed", "Board of Review, "+s.Years())
				@stat("Free", "to file at the Board of Review. You don't need a lawyer or a service to appeal.", "")
			</div>
			<p class="mt-3 text-sm text-slate-600">These are outcomes for people who chose to appeal; they are not a prediction for any one home.</p>
		</section>
		<section class="border-y border-stone-200 bg-white" aria-labelledby="steps">
			<div class="mx-auto max-w-5xl px-5 py-12 sm:py-16">
				<h2 id="steps" class="sr-only">How it works</h2>
				<div class="grid gap-8 sm:gap-10 sm:grid-cols-3">
					@step("1", "Find your home", "Search by address or PIN. We pull your home's details and assessed value from public Assessor data.")
					@step("2", "See how you compare", "We find similar homes nearby in your neighborhood (size, age, style) and compare the building's assessed value per square foot.")
					@step("3", "Decide and file yourself", "You can appeal at the Board of Review for free. We show you the similar homes assessed lower than yours, so you can decide.")
				</div>
				<p class="mt-8 flex flex-wrap gap-x-6 text-sm">
					<a href="/how-it-works" class="inline-flex min-h-11 items-center font-medium text-emerald-800 underline underline-offset-4">How the comparison works →</a>
					<a href="/how-it-works#faq" class="inline-flex min-h-11 items-center font-medium text-emerald-800 underline underline-offset-4">Common questions →</a>
				</p>
			</div>
		</section>
	}
}

templ stat(big, label, foot string) {
	<div class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
		<p class="text-4xl font-semibold tracking-tight text-emerald-700">{ big }</p>
		<p class="mt-2 text-slate-700">{ label }</p>
		if foot != "" {
			<p class="mt-2 text-xs text-slate-600">{ foot }</p>
		}
	</div>
}

templ step(n, title, body string) {
	<div>
		<span class="inline-flex size-8 items-center justify-center rounded-full bg-emerald-100 text-sm font-semibold text-emerald-800">{ n }</span>
		<h3 class="mt-4 font-semibold text-slate-900">{ title }</h3>
		<p class="mt-2 text-slate-600">{ body }</p>
	</div>
}
