package views

templ NotifyForm(pin, reason, errMsg string) {
	@NotifyFormFor(pin, "", reason, errMsg)
}

// NotifyFormFor carries a township slug when there's no PIN (township pages).
templ NotifyFormFor(pin, township, reason, errMsg string) {
	<form hx-post="/notify" hx-swap="outerHTML" action="/notify" method="post" class="space-y-2">
		<input type="hidden" name="pin" value={ pin }/>
		if township != "" {
			<input type="hidden" name="township" value={ township }/>
		}
		<input type="hidden" name="reason" value={ reason }/>
		<label for="email" class="block text-sm font-medium">
			if reason == "township-opens" {
				Email me when my township opens for appeals
			} else {
				Email me when this property type is supported
			}
		</label>
		<div class="flex gap-2">
			<input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com"
				if errMsg != "" {
					aria-invalid="true" aria-describedby="email-error"
				}
				class="min-w-0 flex-1 rounded-xl bg-white px-4 py-2.5 text-slate-900 ring-1 ring-stone-300 outline-none focus:ring-2 focus:ring-emerald-500"/>
			<button type="submit" class="rounded-xl bg-emerald-500 px-4 font-medium text-white hover:bg-emerald-600">Notify me</button>
		</div>
		if errMsg != "" {
			<p id="email-error" role="alert" class="text-sm text-rose-400">{ errMsg }</p>
		}
		<p class="text-xs opacity-60">One or two emails about your appeal window. No spam, and you can unsubscribe anytime.</p>
	</form>
}

templ NotifyThanks() {
	<div role="status" class="rounded-xl bg-emerald-500/10 p-4 ring-1 ring-emerald-500/40">
		<p class="font-medium">You're on the list.</p>
		<p class="text-sm opacity-80">We'll email you when your township opens at the Board of Review.</p>
	</div>
}

templ prose(s Site, title, desc string) {
	@Layout(s, title+" · AssessGap", desc) {
		<article class="mx-auto max-w-2xl px-5 py-14 space-y-4 text-slate-700 leading-relaxed [&_h1]:text-3xl [&_h1]:font-semibold [&_h1]:tracking-tight [&_h1]:text-slate-900 [&_h2]:pt-4 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-slate-900 [&_a]:text-emerald-700 [&_a]:underline [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1">
			{ children... }
		</article>
	}
}

templ HowItWorks(s Site) {
	@prose(s, "How it works", "How AssessGap compares your assessment with similar homes.") {
		<h1>How it works</h1>
		<p>
			In Cook County, your property tax bill depends on your home's assessed value. The Assessor sets it with a model that
			values every home in the county, and the Board of Review hears appeals from owners who think theirs is too high.
		</p>
		<h2>What we compare</h2>
		<p>
			One ground the Board of Review accepts is <em>lack of uniformity</em>: similar homes nearby are assessed lower than yours.
			We look up homes in your Assessor neighborhood with the same property class (or the same broad group), similar size
			(within 25% of your square footage) and similar age (within 15 years). Then we rank them by how closely they match your home's
			size, age, bathrooms, lot, style, exterior and basement.
		</p>
		<p>
			For each one, we divide assessed value by building square footage. If yours is well above the median of similar homes,
			that's the kind of evidence a uniformity appeal uses.
		</p>
		<h2>How we describe the comparison</h2>
		<p>
			We don't tell you whether to appeal. We show how your assessed value per square foot compares with the median of similar homes,
			how many of them are assessed lower than yours, and how appeals have gone for homeowners in your neighborhood. We offer the
			free evidence report (a PDF) when at least 3 similar homes are assessed lower than yours and your home is at least 1% above the median.
		</p>
		<h2>If an appeal doesn't work</h2>
		<p>
			Each tax year you can appeal to the Assessor and then to the Board of Review. If the Board of Review doesn't lower your
			assessment, you can appeal to the state Property Tax Appeal Board. And you can appeal again the next year.
		</p>
		<p>
			We tested this against about 400,000 Board of Review decisions from 2024 and 2025. Among homeowners who appealed on their own,
			homes assessed at least 5% above similar homes got a reduction about 82% of the time. Homes 0–5% above got one about 72% of the time,
			and homes below the median 27–53% of the time. People who appeal usually already have a reason to, so these rates aren't a
			prediction for any one home.
		</p>
		<h2>What we don't do</h2>
		<ul>
			<li>We don't estimate what your home would sell for, and nothing here is an appraisal.</li>
			<li>We aren't a law firm and don't give legal advice. We don't file anything for you or represent you.</li>
			<li>We aren't affiliated with the Assessor, the Board of Review or any government office.</li>
		</ul>
		<h2>Where the data comes from</h2>
		<p>
			Everything comes from Cook County's public open data portal: parcel characteristics, assessed values, sales and Board of Review
			appeal outcomes. We update our copy as the county publishes new data. If the county's data about your home is wrong, our comparison will be too, so check
			the details we show.
		</p>
	}
}

templ Terms(s Site) {
	@prose(s, "Terms of use", "AssessGap terms of use.") {
		<h1>Terms of use</h1>
		<p class="text-sm text-slate-500">Draft, last updated November 24, 2026.</p>
		<p>By using AssessGap you agree to these terms.</p>
		<h2>What AssessGap is</h2>
		<p>
			AssessGap is an information tool. It compares assessed values of similar homes using public Cook County data. It is not a law firm,
			does not provide legal advice, does not represent you before any government body, and is not an appraisal or an opinion of any
			property's value. AssessGap is not affiliated with the Cook County Assessor, the Board of Review or any government office.
		</p>
		<h2>Your decisions</h2>
		<p>
			Whether to appeal, and everything you file, is your decision and your responsibility. You can file an appeal yourself at no cost
			without using AssessGap. Results depend on public data that may contain errors, and appeal outcomes are never guaranteed.
		</p>
		<h2>No warranty</h2>
		<p>
			AssessGap is provided "as is." To the extent the law allows, we disclaim all warranties and are not liable for any indirect or
			consequential damages.
		</p>
		<h2>Acceptable use</h2>
		<p>Don't scrape the site in bulk, interfere with it, or use it for anything unlawful.</p>
		<h2>Contact</h2>
		<p>Questions: <a href="mailto:support@assessgap.com">support@assessgap.com</a>.</p>
	}
}

templ Privacy(s Site) {
	@prose(s, "Privacy", "What AssessGap collects and why.") {
		<h1>Privacy</h1>
		<p class="text-sm text-slate-500">Draft, last updated November 24, 2026.</p>
		<h2>What we collect</h2>
		<ul>
			<li><strong>Searches and pages you view.</strong> Our server logs record the pages requested, including PINs, for troubleshooting and
				counting usage. The property data itself is public county record.</li>
			<li><strong>Your email, if you give it to us</strong>, along with the PIN and township you asked about, so we can tell you when your
				appeal window opens.</li>
		</ul>
		<p>We don't use advertising trackers or third-party analytics, and we don't set tracking cookies.</p>
		<h2>What we do with it</h2>
		<p>We use your email only for the notices you asked for. We don't sell or share it, except with the service that sends our email.</p>
		<h2>Deleting your data</h2>
		<p>Email <a href="mailto:support@assessgap.com">support@assessgap.com</a> and we'll delete your email and anything tied to it.</p>
	}
}
