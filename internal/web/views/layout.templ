package views

templ Layout(s Site, title, desc string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="description" content={ desc }/>
			if s.Dev {
				<meta name="robots" content="noindex, nofollow"/>
			}
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href={ s.CSS }/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="min-h-full flex flex-col bg-stone-50 text-slate-800 antialiased">
			<header class="border-b border-stone-200 bg-white/80 backdrop-blur sticky top-0 z-10">
				<div class="mx-auto max-w-5xl px-5 h-14 flex items-center justify-between">
					<a href="/" class="flex shrink-0 items-center gap-2 font-semibold tracking-tight text-slate-900">
						<span class="inline-flex size-7 items-center justify-center rounded-lg bg-emerald-600 text-white text-sm">AG</span>
						AssessGap
					</a>
					<nav class="flex items-center gap-3 sm:gap-5 text-sm text-slate-600 whitespace-nowrap">
						<a href="/how-it-works" class="hidden sm:inline hover:text-slate-900">How it works</a>
						<a href="/#check" class="rounded-full bg-slate-900 px-3.5 py-1.5 font-medium text-white hover:bg-slate-700">Check my home</a>
					</nav>
				</div>
			</header>
			<main class="flex-1">
				{ children... }
			</main>
			<footer class="border-t border-stone-200 bg-white">
				<div class="mx-auto max-w-5xl px-5 py-8 text-sm text-slate-500 space-y-3">
					<p>
						AssessGap is an independent tool. It is not affiliated with the Cook County Assessor, the Board of Review,
						or any government office. It is not a law firm and does not give legal advice, and it is not an appraisal.
						You can always file an appeal yourself for free.
					</p>
					<p class="flex flex-wrap gap-x-5 gap-y-1">
						<a href="/how-it-works" class="hover:text-slate-800">How it works</a>
						<a href="/terms" class="hover:text-slate-800">Terms</a>
						<a href="/privacy" class="hover:text-slate-800">Privacy</a>
						<a href="mailto:support@assessgap.com" class="hover:text-slate-800">support@assessgap.com</a>
					</p>
				</div>
			</footer>
		</body>
	</html>
}

templ SearchBox(q string, autofocus bool) {
	<form action="/search" method="get" class="relative" role="search">
		<label for="q" class="mb-2 block text-sm font-medium text-slate-700">Your home address or PIN</label>
		<div class="flex rounded-2xl bg-white shadow-sm ring-1 ring-stone-300 focus-within:ring-2 focus-within:ring-emerald-600">
			<input
				id="q"
				name="q"
				type="search"
				value={ q }
				autocomplete="off"
				autofocus?={ autofocus }
				placeholder="e.g. 1234 W Main St"
				class="min-w-0 flex-1 bg-transparent px-4 sm:px-5 py-4 text-lg outline-none placeholder:text-slate-400"
				hx-get="/search"
				hx-trigger="input changed delay:200ms, search"
				hx-target="#results"
				hx-sync="this:replace"
			/>
			<button type="submit" class="m-1.5 rounded-xl bg-emerald-600 px-5 font-medium text-white hover:bg-emerald-700">
				Check
			</button>
		</div>
		<div id="results" class="absolute inset-x-0 top-full z-20 mt-2"></div>
		<p class="mt-2 text-sm text-slate-500">Cook County homes. You can also paste your 14-digit PIN from your tax bill.</p>
	</form>
}

templ SearchResults(q string, ms []Match) {
	if len(ms) > 0 {
		<ul class="overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-stone-200 divide-y divide-stone-100 text-left">
			for _, m := range ms {
				<li>
					<a href={ templ.SafeURL("/check/" + m.PIN) } class="flex items-center justify-between gap-4 px-5 py-3 hover:bg-emerald-50 focus:bg-emerald-50 outline-none">
						<span>
							<span class="font-medium text-slate-900">{ m.Address }</span>
							<span class="text-slate-500">{ m.City }</span>
						</span>
						<span class="shrink-0 text-xs text-slate-400">{ m.Kind } · { m.PINFmt }</span>
					</a>
				</li>
			}
		</ul>
	} else if len(q) >= 3 {
		<div class="rounded-2xl bg-white px-5 py-4 text-slate-500 shadow-lg ring-1 ring-stone-200 text-left">
			No Cook County address starts with “{ q }”. Try the street number and name, like “1234 W Main”.
		</div>
	}
}

templ SearchPage(s Site, q string, ms []Match) {
	@Layout(s, "Search · AssessGap", "Find your Cook County home.") {
		<section class="mx-auto max-w-2xl px-5 py-14">
			<h1 class="text-2xl font-semibold tracking-tight text-slate-900 mb-6">Find your home</h1>
			@SearchBox(q, false)
			<div class="mt-16">
				@SearchResults(q, ms)
			</div>
		</section>
	}
}

templ NotFound(s Site) {
	@Layout(s, "Not found · AssessGap", "") {
		<section class="mx-auto max-w-2xl px-5 py-24 text-center">
			<h1 class="text-2xl font-semibold text-slate-900">We couldn't find that page or PIN</h1>
			<p class="mt-3 text-slate-600">Try searching by address instead.</p>
			<div class="mt-8 text-left">
				@SearchBox("", false)
			</div>
		</section>
	}
}

templ Error(s Site) {
	@Layout(s, "Something went wrong · AssessGap", "") {
		<section class="mx-auto max-w-2xl px-5 py-24 text-center">
			<h1 class="text-2xl font-semibold text-slate-900">Something went wrong on our end</h1>
			<p class="mt-3 text-slate-600">Please try again in a minute. If it keeps happening, email support@assessgap.com.</p>
		</section>
	}
}
