package views

templ Layout(s Site, title, desc string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full scroll-pt-20">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="description" content={ desc }/>
			@shareTags(title, desc)
			if s.Dev {
				<meta name="robots" content="noindex, nofollow"/>
			}
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href={ s.CSS }/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body class="min-h-full flex flex-col bg-stone-50 text-slate-800 antialiased">
			<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-medium focus:text-slate-900 focus:ring-2 focus:ring-emerald-700">Skip to content</a>
			@siteHeader(shareFrom(ctx).Path)
			<main id="main" tabindex="-1" class="flex-1 outline-hidden">
				{ children... }
			</main>
			@siteFooter()
		</body>
	</html>
}

templ SearchBox(q string, autofocus bool) {
	@searchForm(q, autofocus, "Your home address or PIN")
}

// searchForm is the address/PIN search; label names it for the page it's on.
templ searchForm(q string, autofocus bool, label string) {
	<form action="/search" method="get" class="relative" role="search">
		<label for="q" class="mb-2 block text-sm font-medium text-slate-700">{ label }</label>
		<div class="flex rounded-2xl bg-white shadow-sm ring-1 ring-stone-300 focus-within:ring-2 focus-within:ring-emerald-700">
			<input
				id="q"
				name="q"
				type="search"
				value={ q }
				autocomplete="off"
				autofocus?={ autofocus }
				placeholder="e.g. 1234 W Main St"
				aria-describedby="q-help"
				aria-controls="results"
				class="min-w-0 flex-1 bg-transparent px-4 sm:px-5 py-4 text-lg outline-hidden placeholder:text-slate-500"
				hx-get="/search"
				hx-trigger="input changed delay:200ms, search"
				hx-target="#results"
				hx-sync="this:replace"
			/>
			<button type="submit" class="m-1.5 min-w-11 rounded-xl bg-emerald-700 px-5 font-medium text-white hover:bg-emerald-800">
				Check
			</button>
		</div>
		<div id="results" aria-live="polite" class="absolute inset-x-0 top-full z-20 mt-2 max-h-[70vh] overflow-y-auto rounded-2xl"></div>
		<p id="q-help" class="mt-2 text-sm text-slate-600">Cook County homes. You can also paste your 14-digit PIN from your tax bill.</p>
	</form>
}

templ SearchResults(q string, ms []Match) {
	if len(ms) > 0 {
		<ul class="overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-stone-200 divide-y divide-stone-100 text-left">
			for _, m := range ms {
				<li class="flex flex-col sm:flex-row sm:items-stretch">
					<a href={ templ.SafeURL("/check/" + m.PIN) } class="block flex-1 px-5 py-3 hover:bg-emerald-50 focus-visible:bg-emerald-50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-emerald-700">
						<span class="block">
							<span class="font-medium text-slate-900">{ m.Address }</span>
							{ " " }
							<span class="text-slate-600">{ m.City }</span>
						</span>
						<span class="block text-xs text-slate-500">{ m.Kind } · { m.PINFmt }</span>
					</a>
					if m.TownshipURL != "" {
						<a href={ templ.SafeURL(m.TownshipURL) } class="flex min-h-11 shrink-0 items-center px-5 pb-2 text-sm text-emerald-800 underline underline-offset-4 hover:bg-emerald-50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-emerald-700 sm:pb-0">{ m.Township } Township dates →</a>
					}
				</li>
			}
		</ul>
	} else if len(q) >= 3 {
		<div class="rounded-2xl bg-white px-5 py-4 text-slate-600 shadow-lg ring-1 ring-stone-200 text-left">
			No Cook County address starts with “{ q }”. Try the street number and name, like “1234 W Main”.
		</div>
	}
}

templ SearchPage(s Site, q string, ms []Match) {
	@Layout(s, "Search · AssessGap", "Find your Cook County home.") {
		<section class="mx-auto max-w-2xl px-5 py-10 sm:py-14">
			<h1 class="text-2xl font-semibold tracking-tight text-slate-900 mb-6">Find your home</h1>
			@SearchBox(q, false)
			<div class="mt-16">
				@SearchResults(q, ms)
			</div>
		</section>
	}
}

// NotFound is the 404 for any path that isn't a page or a known PIN.
templ NotFound(s Site) {
	@Layout(s, "Not found · AssessGap", "") {
		<section class="mx-auto max-w-2xl px-5 py-14 sm:py-24">
			<h1 class="text-2xl font-semibold tracking-tight text-slate-900">We couldn't find that page or PIN</h1>
			<p class="mt-3 text-slate-600">Search for your home by address or PIN, or go to one of the pages below.</p>
			<div class="mt-8">
				@SearchBox("", false)
			</div>
			@pageLinks()
		</section>
	}
}

// NotFoundTownship is the 404 for /townships/<name> when no township has that
// name. It lists them all, so the next tap can be the right one.
templ NotFoundTownship(s Site, all []TownshipLink) {
	@Layout(s, "Township not found · AssessGap", "") {
		<section class="mx-auto max-w-3xl px-5 py-10 sm:py-14">
			@breadcrumbs([]Crumb{{Name: "Home", Path: "/"}, {Name: "Townships", Path: "/townships"}, {Name: "Not found"}}, false)
			<h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">We couldn't find that township</h1>
			<p class="mt-3 text-slate-600">
				Cook County has 38 townships. Pick yours below, or see
				<a href="/townships" class="text-emerald-700 underline underline-offset-4">all townships and their appeal dates</a>.
			</p>
			<div class="mt-6">
				@townshipAZ(all)
			</div>
		</section>
	}
}

// pageLinks are the way onward from a page that has nothing else to offer.
templ pageLinks() {
	<ul class="mt-8 flex flex-wrap gap-x-6 text-emerald-700">
		<li><a href="/" class="inline-flex min-h-11 items-center underline underline-offset-4">Home page</a></li>
		<li><a href="/townships" class="inline-flex min-h-11 items-center underline underline-offset-4">Appeal dates by township</a></li>
		<li><a href="/how-it-works" class="inline-flex min-h-11 items-center underline underline-offset-4">How it works</a></li>
	</ul>
}

templ Error(s Site) {
	@Layout(s, "Something went wrong · AssessGap", "") {
		<section class="mx-auto max-w-2xl px-5 py-14 sm:py-24">
			<h1 class="text-2xl font-semibold tracking-tight text-slate-900">Something went wrong on our end</h1>
			<p class="mt-3 text-slate-600">
				Please try again in a minute. If it keeps happening, email
				<a href="mailto:support@assessgap.com" class="text-emerald-700 underline underline-offset-4">support@assessgap.com</a>.
			</p>
			@pageLinks()
		</section>
	}
}
