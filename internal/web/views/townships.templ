package views

import (
	"fmt"
	"github.com/assessgap/assessgap/internal/bor"
)

templ Townships(s Site, x TownshipIndex) {
	@Layout(s, "Cook County property tax appeal deadlines by township (Board of Review) · AssessGap",
		"Board of Review appeal dates for all 38 Cook County townships: which are open now, which open soon, and where the Board hasn't posted dates yet.") {
		<div class="mx-auto max-w-3xl px-5 py-8 sm:py-10 space-y-8">
			<header>
				@breadcrumbs([]Crumb{{Name: "Home", Path: "/"}, {Name: "Townships", Path: "/townships"}}, true)
				<h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 text-balance">Board of Review appeal dates by township</h1>
				<p class="mt-3 text-slate-600">
					The Cook County Board of Review opens each of the county's 38 townships for appeals each session, for at least 30 days.
					Pick your township for its dates, recent appeal outcomes and how to file on your own.
				</p>
				<p class="mt-2 text-sm text-slate-600">
					From the Board's { fmt.Sprint(bor.SessionYear) } schedule, checked { x.ScheduleAsOf }.
					<a href={ templ.SafeURL(bor.DatesURL) } rel="noopener" class="text-emerald-700 underline underline-offset-4">The Board's dates and deadlines →</a>
				</p>
			</header>
			<section aria-labelledby="az" class="rounded-2xl bg-white p-5 ring-1 ring-stone-200">
				<h2 id="az" class="font-semibold text-slate-900">All 38 townships, A–Z</h2>
				<div class="mt-3">
					@townshipAZ(x.All)
				</div>
			</section>
			<section aria-labelledby="find" class="rounded-2xl bg-white p-5 ring-1 ring-stone-200">
				<h2 id="find" class="font-semibold text-slate-900">Find your township</h2>
				<p class="mt-1 mb-4 text-sm text-slate-600">Not sure which township you're in? Search your address: each result names its township and links to its dates.</p>
				@searchForm("", false, "Your address or PIN")
			</section>
			<nav aria-label="Townships by appeal status" class="flex flex-wrap gap-x-5 text-sm">
				for _, g := range x.Groups {
					if len(g.Townships) > 0 {
						<a href={ templ.SafeURL("#g-" + g.State) } class="inline-flex min-h-11 items-center text-emerald-700 underline underline-offset-4">{ g.Heading } ({ fmt.Sprint(len(g.Townships)) })</a>
					}
				}
			</nav>
			for _, g := range x.Groups {
				if len(g.Townships) > 0 {
					<section aria-labelledby={ "g-" + g.State }>
						<h2 id={ "g-" + g.State } class="text-lg font-semibold text-slate-900">
							{ g.Heading } <span class="font-normal text-slate-600">({ fmt.Sprint(len(g.Townships)) })</span>
						</h2>
						if g.State == "unscheduled" {
							<p class="mt-1 text-sm text-slate-600">You can pre-register on the Board's portal before your township opens.</p>
						}
						<ul class="mt-3 overflow-hidden rounded-2xl bg-white ring-1 ring-stone-200 divide-y divide-stone-100">
							for _, t := range g.Townships {
								<li>
									<a href={ templ.SafeURL("/townships/" + t.Slug) } class="flex flex-col gap-y-0.5 px-5 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-x-5 hover:bg-emerald-50 focus-visible:bg-emerald-50">
										<span class="font-medium text-slate-900">{ t.Name }</span>
										<span class="text-sm text-slate-600">{ t.Dates }</span>
									</a>
								</li>
							}
						</ul>
					</section>
				}
			}
		</div>
	}
}

// townshipAZ links every township's page, A–Z, in a compact grid.
templ townshipAZ(all []TownshipLink) {
	<ul class="grid grid-cols-3 gap-x-2 text-sm sm:grid-cols-5 sm:gap-x-4">
		for _, t := range all {
			<li><a href={ templ.SafeURL("/townships/" + t.Slug) } class="flex min-h-11 items-center text-emerald-800 underline-offset-4 hover:underline sm:min-h-9">{ t.Name }</a></li>
		}
	</ul>
}

templ Township(s Site, t TownshipData) {
	@Layout(s, t.Name+" Township property tax appeal deadline (Board of Review) · AssessGap",
		t.Name+" Township, Cook County: Board of Review appeal dates and evidence deadline (when posted), recent appeal outcomes, and how to file on your own.") {
		<div class="mx-auto max-w-3xl px-5 py-8 sm:py-10 space-y-8">
			<header>
				@breadcrumbs(TownshipCrumbs(t.Name, t.Slug), true)
				<h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 text-balance">{ t.Name } Township property tax appeals</h1>
				<p class="mt-2 text-slate-600">
					Cook County Board of Review dates for { t.Name } Township, recent appeal outcomes, and how to file on your own.
					<a href="/townships" class="whitespace-nowrap text-emerald-700 underline underline-offset-4">Not { t.Name }? All townships →</a>
				</p>
			</header>
			@townshipWindow(t)
			<section>
				<h2 class="mb-3 text-lg font-semibold text-slate-900">Check a home in { t.Name }</h2>
				@SearchBox("", false)
			</section>
			@fileSteps(t)
			@townshipFacts(t)
			if t.Window.State != "open" {
				<section class="rounded-3xl bg-slate-900 p-6 sm:p-8 text-slate-100">
					<h2 class="text-xl font-semibold text-white">
						if t.Window.State == "closed" {
							Get an email when { t.Name } opens again
						} else {
							Get an email when { t.Name } opens
						}
					</h2>
					<p class="mt-2 text-slate-300">We'll write when the Board of Review opens { t.Name } Township for appeals.</p>
					<div class="mt-4 max-w-lg">
						@NotifyFormFor("", t.Slug, "township-opens", "")
					</div>
				</section>
			}
			<nav aria-label="Other townships" class="flex flex-wrap items-center justify-between gap-x-4 border-t border-stone-200 pt-4 text-sm">
				<a href={ templ.SafeURL("/townships/" + t.Prev.Slug) } rel="prev" class="inline-flex min-h-11 items-center text-emerald-700 underline underline-offset-4">← { t.Prev.Name }</a>
				<a href="/townships" class="inline-flex min-h-11 items-center font-medium text-emerald-700 underline underline-offset-4">All townships</a>
				<a href={ templ.SafeURL("/townships/" + t.Next.Slug) } rel="next" class="inline-flex min-h-11 items-center text-emerald-700 underline underline-offset-4">{ t.Next.Name } →</a>
			</nav>
		</div>
	}
}

templ townshipWindow(t TownshipData) {
	{{ w := t.Window }}
	<section aria-labelledby="window" class={ "rounded-2xl p-6 ring-1",
		templ.KV("bg-emerald-50 ring-emerald-200 text-emerald-900", w.State == "open"),
		templ.KV("bg-sky-50 ring-sky-200 text-sky-900", w.State == "upcoming" || w.State == "unscheduled"),
		templ.KV("bg-stone-100 ring-stone-200 text-slate-700", w.State == "closed") }>
		<h2 id="window" class="text-sm font-medium">Board of Review filing window, { fmt.Sprint(bor.SessionYear) } session</h2>
		<p class="mt-1 text-2xl font-semibold tracking-tight">
			{ w.Label }
			if w.DaysLeft != "" {
				<span class="font-normal">· { w.DaysLeft }</span>
			}
		</p>
		if w.Open != "" {
			<dl class="mt-4 grid gap-4 sm:grid-cols-3">
				<div><dt class="text-sm opacity-80">Opens</dt><dd class="font-semibold">{ w.Open }</dd></div>
				<div><dt class="text-sm opacity-80">Closes</dt><dd class="font-semibold">{ w.Close }</dd></div>
				<div><dt class="text-sm opacity-80">Evidence deadline</dt><dd class="font-semibold">{ w.EvidenceDue }</dd></div>
			</dl>
			<p class="mt-4 text-sm opacity-80">From the Board's posted schedule (group { w.Group }), checked { t.ScheduleAsOf }.</p>
		} else {
			<p class="mt-3">The Board hasn't posted dates yet (as of { t.ScheduleAsOf }). It opens each township after the Assessor has assessed it, and says its dates aren't set in advance.</p>
		}
		<p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
			switch w.State {
				case "open":
					<a href={ templ.SafeURL(bor.PortalURL) } rel="noopener" class="inline-flex min-h-11 items-center underline underline-offset-4">File on the Board's portal →</a>
				case "upcoming", "unscheduled":
					<a href={ templ.SafeURL(bor.PortalURL) } rel="noopener" class="inline-flex min-h-11 items-center underline underline-offset-4">Pre-register with the Board →</a>
			}
			<a href={ templ.SafeURL(bor.DatesURL) } rel="noopener" class="inline-flex min-h-11 items-center underline underline-offset-4">The Board's dates and deadlines →</a>
		</p>
	</section>
}

templ townshipFacts(t TownshipData) {
	<section class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
		<h2 class="text-lg font-semibold text-slate-900">{ t.Name } Township in the county data</h2>
		if t.Homes != "" {
			<p class="mt-3 text-slate-700">
				<strong class="font-semibold">{ t.Homes }</strong> parcels in classes 202–210, 234, 278 and 295, the single-family and
				townhome classes AssessGap compares. A few, such as parcels with more than one building, can't be checked yet.
			</p>
		}
		if t.ProSe != nil || t.Attorney != nil {
			<h3 class="mt-6 font-semibold text-slate-900">Recent Board of Review outcomes</h3>
			<div class="mt-2 overflow-x-auto">
				<table class="w-full text-sm">
					<thead class="bg-stone-50 text-left text-slate-500">
						<tr>
							<th scope="col" class="px-2 sm:px-3 py-2 font-medium">Filed by</th>
							<th scope="col" class="px-2 sm:px-3 py-2 font-medium text-right">Appeals</th>
							<th scope="col" class="px-2 sm:px-3 py-2 font-medium text-right">Got a reduction</th>
							<th scope="col" class="px-2 sm:px-3 py-2 font-medium text-right">Average reduction</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-100">
						@appealsRow("Filed on their own (pro se)", t.ProSe)
						@appealsRow("Filed by an attorney", t.Attorney)
					</tbody>
				</table>
			</div>
			<p class="mt-3 text-sm text-slate-500">
				Source: Cook County Board of Review appeal decisions on the county's open data portal, tax years { townshipYears(t) }:
				residential appeals other than condominiums. The average reduction is among appeals that got one, as a share of assessed value.
				These are outcomes for people who chose to appeal, who usually had a reason to. They aren't a prediction for any one home.
			</p>
		} else {
			<p class="mt-3 text-slate-700">We don't have recent Board of Review appeal records for { t.Name } Township.</p>
		}
	</section>
}

templ appealsRow(label string, a *TownshipAppeals) {
	<tr>
		<th scope="row" class="px-2 sm:px-3 py-2.5 text-left font-medium text-slate-900">{ label }</th>
		if a != nil {
			<td class="px-2 sm:px-3 py-2.5 text-right tabular-nums">{ a.Appeals }</td>
			<td class="px-2 sm:px-3 py-2.5 text-right tabular-nums">{ a.Reduced }</td>
			<td class="px-2 sm:px-3 py-2.5 text-right tabular-nums">{ a.AvgCut }</td>
		} else {
			<td class="px-2 sm:px-3 py-2.5 text-right tabular-nums">0</td>
			<td class="px-2 sm:px-3 py-2.5 text-right"></td>
			<td class="px-2 sm:px-3 py-2.5 text-right"></td>
		}
	</tr>
}

func townshipYears(t TownshipData) string {
	if t.ProSe != nil {
		return t.ProSe.Years
	}
	return t.Attorney.Years
}

templ fileSteps(t TownshipData) {
	<section id="file" class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
		<h2 class="text-lg font-semibold text-slate-900">How to file on your own</h2>
		<p class="mt-2 text-slate-600">
			{ "Board Rule 1: individual taxpayers “may represent properties titled in their own names”, and “a person who is not an attorney may not represent a taxpayer before the Board of Review.”" }
		</p>
		<ol class="mt-4 space-y-4 text-slate-700">
			@fileStep("1", "Find your 14-digit PIN. It's on your tax bill, and the search above shows it too.")
			@fileStep("2", "While "+t.Name+" is open, go to the Board's appeals portal and choose “Submit an Appeal”, then the appeal type “"+bor.AppealType+"”. You can file with an account or as a guest; guests get the decision by mail only.")
			@fileStep("3", evidenceStep(t))
			@fileStep("4", "You can ask for a hearing when you file. Hearings for people filing on their own are by phone, and you aren't penalized for skipping one. The Board says decisions come "+bor.DecisionWeeks+" weeks after the township closes.")
			@fileStep("5", fmt.Sprintf("If you disagree with the decision, you can ask the Board for a re-review within %d days of the date on the decision letter, on one of the grounds in Board Rule 26 (no new arguments), or appeal to the state Property Tax Appeal Board within %d days of the Board's written decision.", bor.ReReviewDays, bor.PTABDays))
		</ol>
		<p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
			<a href="/how-it-works" class="inline-flex min-h-11 items-center text-emerald-700 underline underline-offset-4">How AssessGap's comparison works</a>
			<a href="https://github.com/assessgap/assessgap/blob/main/docs/bor-filing-facts.md" rel="noopener" class="inline-flex min-h-11 items-center text-emerald-700 underline underline-offset-4">Our filing notes, with sources</a>
		</p>
	</section>
}

func evidenceStep(t TownshipData) string {
	due := "by the evidence deadline the Board posts with the township's dates"
	if t.Window.EvidenceDue != "" && t.Window.State != "closed" {
		due = "by the evidence deadline, " + t.Window.EvidenceDue
	}
	return "Upload your evidence " + due + ". The Board's rules ask for a brief that includes a color photo of the front of the home taken within the last 12 months. Listing comparable homes is optional."
}

// NotifyAlready answers a signup whose email (and PIN, if any) is already on
// the list; nothing was stored.
templ NotifyAlready() {
	<div role="status" class="rounded-xl bg-emerald-500/10 p-4 ring-1 ring-emerald-500/40">
		<p class="font-medium">This email is already on our list.</p>
		<p class="text-sm opacity-80">Nothing changed. For now we keep one signup per email address, so a second township isn't added.</p>
	</div>
}

templ fileStep(n, text string) {
	<li class="flex gap-3">
		<span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-sm font-semibold text-emerald-800">{ n }</span>
		<span>{ text }</span>
	</li>
}
