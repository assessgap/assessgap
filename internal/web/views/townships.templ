package views

import (
	"fmt"
	"github.com/assessgap/assessgap/internal/bor"
)

templ Townships(s Site, x TownshipIndex) {
	@Layout(s, "Cook County property tax appeal deadlines by township (Board of Review) · AssessGap",
		"Board of Review appeal dates for all 38 Cook County townships: which are open now, which open soon, and where the Board hasn't posted dates yet.") {
		<div class="mx-auto max-w-3xl px-5 py-10 space-y-8">
			<header>
				<h1 class="text-3xl font-semibold tracking-tight text-slate-900 text-balance">Board of Review appeal dates by township</h1>
				<p class="mt-3 text-slate-600">
					The Cook County Board of Review opens each of the county's 38 townships for appeals once a year, for at least 30 days.
					Pick your township for its dates, recent appeal outcomes and how to file on your own.
				</p>
				<p class="mt-2 text-sm text-slate-500">
					From the Board's { fmt.Sprint(bor.SessionYear) } schedule, checked { x.ScheduleAsOf }.
					<a href={ templ.SafeURL(bor.DatesURL) } rel="noopener" class="text-emerald-700 underline">The Board's dates and deadlines</a>
				</p>
			</header>
			for _, g := range x.Groups {
				if len(g.Townships) > 0 {
					<section aria-labelledby={ "g-" + g.State }>
						<h2 id={ "g-" + g.State } class="text-lg font-semibold text-slate-900">
							{ g.Heading } <span class="font-normal text-slate-500">({ fmt.Sprint(len(g.Townships)) })</span>
						</h2>
						if g.State == "unscheduled" {
							<p class="mt-1 text-sm text-slate-500">You can pre-register on the Board's portal before your township opens.</p>
						}
						<ul class="mt-3 overflow-hidden rounded-2xl bg-white ring-1 ring-stone-200 divide-y divide-stone-100">
							for _, t := range g.Townships {
								<li>
									<a href={ templ.SafeURL("/townships/" + t.Slug) } class="flex flex-wrap items-center justify-between gap-x-5 gap-y-1 px-5 py-3 hover:bg-emerald-50 focus:bg-emerald-50">
										<span class="font-medium text-slate-900">{ t.Name }</span>
										<span class="text-sm text-slate-500">{ t.Dates }</span>
									</a>
								</li>
							}
						</ul>
					</section>
				}
			}
		</div>
	}
}

templ Township(s Site, t TownshipData) {
	@Layout(s, t.Name+" Township property tax appeal deadline (Board of Review) · AssessGap",
		t.Name+" Township, Cook County: Board of Review appeal dates, the evidence deadline, recent appeal outcomes, and how homeowners file on their own for free.") {
		@templ.Raw(breadcrumbJSON(ctx, t.Name, t.Slug))
		<div class="mx-auto max-w-3xl px-5 py-10 space-y-8">
			<header>
				<nav aria-label="Breadcrumb" class="text-sm text-slate-500">
					<a href="/" class="hover:underline">Home</a> ›
					<a href="/townships" class="hover:underline">Townships</a> ›
					<span aria-current="page">{ t.Name }</span>
				</nav>
				<h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 text-balance">{ t.Name } Township property tax appeals</h1>
				<p class="mt-2 text-slate-600">Cook County Board of Review dates for { t.Name } Township, recent appeal outcomes, and how to file on your own.</p>
			</header>
			@townshipWindow(t)
			<section>
				<h2 class="mb-3 text-lg font-semibold text-slate-900">Check a home in { t.Name }</h2>
				@SearchBox("", false)
			</section>
			@townshipFacts(t)
			@fileSteps(t)
			<section class="rounded-3xl bg-slate-900 p-6 sm:p-8 text-slate-100">
				<h2 class="text-xl font-semibold text-white">Get an email when { t.Name } opens</h2>
				<p class="mt-2 text-slate-300">We'll write when the Board of Review opens { t.Name } Township for appeals.</p>
				<div class="mt-4 max-w-lg">
					@NotifyFormFor("", t.Slug, "township-opens", "")
				</div>
			</section>
		</div>
	}
}

templ townshipWindow(t TownshipData) {
	{{ w := t.Window }}
	<section aria-labelledby="window" class={ "rounded-2xl p-6 ring-1",
		templ.KV("bg-emerald-50 ring-emerald-200 text-emerald-900", w.State == "open"),
		templ.KV("bg-sky-50 ring-sky-200 text-sky-900", w.State == "upcoming" || w.State == "unscheduled"),
		templ.KV("bg-stone-100 ring-stone-200 text-slate-700", w.State == "closed") }>
		<h2 id="window" class="text-sm font-medium">Board of Review filing window, { fmt.Sprint(bor.SessionYear) } session</h2>
		<p class="mt-1 text-2xl font-semibold tracking-tight">
			{ w.Label }
			if w.DaysLeft != "" {
				<span class="font-normal">· { w.DaysLeft }</span>
			}
		</p>
		if w.Open != "" {
			<dl class="mt-4 grid gap-4 sm:grid-cols-3">
				<div><dt class="text-sm opacity-80">Opens</dt><dd class="font-semibold">{ w.Open }</dd></div>
				<div><dt class="text-sm opacity-80">Closes (last day to file)</dt><dd class="font-semibold">{ w.Close }</dd></div>
				<div><dt class="text-sm opacity-80">Evidence deadline</dt><dd class="font-semibold">{ w.EvidenceDue }</dd></div>
			</dl>
			<p class="mt-4 text-sm opacity-80">From the Board's posted schedule (group { w.Group }), checked { t.ScheduleAsOf }.</p>
		} else {
			<p class="mt-3">The Board hasn't posted dates yet (as of { t.ScheduleAsOf }). It opens each township after the Assessor certifies it, and its dates aren't set in advance.</p>
		}
		<p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
			if w.State == "open" {
				<a href={ templ.SafeURL(bor.PortalURL) } rel="noopener" class="underline underline-offset-4">File on the Board's portal →</a>
			} else {
				<a href={ templ.SafeURL(bor.PortalURL) } rel="noopener" class="underline underline-offset-4">Pre-register with the Board →</a>
			}
			<a href={ templ.SafeURL(bor.DatesURL) } rel="noopener" class="underline underline-offset-4">The Board's dates and deadlines →</a>
		</p>
	</section>
}

templ townshipFacts(t TownshipData) {
	<section class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
		<h2 class="text-lg font-semibold text-slate-900">{ t.Name } Township in the county data</h2>
		<p class="mt-3 text-slate-700">
			<strong class="font-semibold">{ t.Homes }</strong> homes in the property classes AssessGap checks
			(single-family homes and townhomes, classes 202–210, 234, 278 and 295).
		</p>
		if t.ProSe != nil || t.Attorney != nil {
			<h3 class="mt-6 font-semibold text-slate-900">Recent Board of Review outcomes</h3>
			<div class="mt-2 overflow-x-auto">
				<table class="w-full text-sm">
					<thead class="bg-stone-50 text-left text-slate-500">
						<tr>
							<th scope="col" class="px-3 py-2 font-medium">Filed by</th>
							<th scope="col" class="px-3 py-2 font-medium text-right">Appeals</th>
							<th scope="col" class="px-3 py-2 font-medium text-right">Got a reduction</th>
							<th scope="col" class="px-3 py-2 font-medium text-right">Average reduction</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-100">
						@appealsRow("Homeowners on their own", t.ProSe)
						@appealsRow("Attorneys or tax firms", t.Attorney)
					</tbody>
				</table>
			</div>
			<p class="mt-3 text-sm text-slate-500">
				Source: Cook County Board of Review appeal decisions on the county's open data portal, tax years { townshipYears(t) }:
				residential appeals other than condominiums. The average reduction is among appeals that got one, as a share of assessed value.
				These are outcomes for people who chose to appeal, who usually had a reason to. They aren't a prediction for any home.
			</p>
		} else {
			<p class="mt-3 text-slate-700">We don't have recent Board of Review appeal records for { t.Name } Township.</p>
		}
	</section>
}

templ appealsRow(label string, a *TownshipAppeals) {
	<tr>
		<th scope="row" class="px-3 py-2.5 text-left font-medium text-slate-900">{ label }</th>
		if a != nil {
			<td class="px-3 py-2.5 text-right tabular-nums">{ a.Appeals }</td>
			<td class="px-3 py-2.5 text-right tabular-nums">{ a.Reduced }</td>
			<td class="px-3 py-2.5 text-right tabular-nums">{ a.AvgCut }</td>
		} else {
			<td class="px-3 py-2.5 text-right tabular-nums">0</td>
			<td class="px-3 py-2.5 text-right"></td>
			<td class="px-3 py-2.5 text-right"></td>
		}
	</tr>
}

func townshipYears(t TownshipData) string {
	if t.ProSe != nil {
		return t.ProSe.Years
	}
	return t.Attorney.Years
}

templ fileSteps(t TownshipData) {
	<section class="rounded-2xl bg-white p-6 ring-1 ring-stone-200">
		<h2 class="text-lg font-semibold text-slate-900">How to file on your own</h2>
		<p class="mt-2 text-slate-600">
			{ "Filing at the Board of Review is free. Homeowners can file for a home in their own name; anyone else filing for you must be a licensed attorney (Board Rule 1)." }
		</p>
		<ol class="mt-4 space-y-4 text-slate-700">
			@fileStep("1", "Find your 14-digit PIN. It's on your tax bill, and the search above shows it too.")
			@fileStep("2", "While "+t.Name+" is open, go to the Board's appeals portal and choose “Submit an Appeal”, then the appeal type “"+bor.AppealType+"”. You can file with an account or as a guest; guests get the decision by mail only.")
			@fileStep("3", evidenceStep(t))
			@fileStep("4", "You can ask for a hearing when you file. Homeowners' hearings are by phone, and you aren't penalized for skipping one. The Board says decisions come "+bor.DecisionWeeks+" weeks after the township closes.")
			@fileStep("5", fmt.Sprintf("If you disagree with the decision, you can ask the Board for a re-review within %d days of the decision letter, or appeal to the state Property Tax Appeal Board within %d days of the decision.", bor.ReReviewDays, bor.PTABDays))
		</ol>
		<p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
			<a href="/how-it-works" class="text-emerald-700 underline">How AssessGap's comparison works</a>
			<a href="https://github.com/assessgap/assessgap/blob/main/docs/bor-filing-facts.md" rel="noopener" class="text-emerald-700 underline">Our filing notes, with sources</a>
		</p>
	</section>
}

func evidenceStep(t TownshipData) string {
	due := "by the evidence deadline the Board posts with the township's dates"
	if t.Window.EvidenceDue != "" {
		due = "by the evidence deadline, " + t.Window.EvidenceDue
	}
	return "Upload your evidence " + due + ". The Board's rules ask for a brief that includes a color photo of the front of the home taken within the last 12 months. Listing comparable homes is optional."
}

templ fileStep(n, text string) {
	<li class="flex gap-3">
		<span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-sm font-semibold text-emerald-800">{ n }</span>
		<span>{ text }</span>
	</li>
}
